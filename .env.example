# TactiFrame environment configuration template
# Copy to .env and fill in your values. Never commit .env to git.

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=tactiframe-sessions
AWS_ENABLED=false
AWS_PROFILE=

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── AgentCore (optional) ──────────────────────────────────────────────────────
AGENTCORE_ENABLED=false
AGENTCORE_RUNTIME_ID=

# ── Perception ────────────────────────────────────────────────────────────────
YOLO_WEIGHTS_PATH=models/yolo.pt
YOLO_CONF_THRESHOLD=0.5

# ── Zone Analyzer ─────────────────────────────────────────────────────────────
ZONE_ROWS=4
ZONE_COLS=3

# ── Approval Gate ─────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_SECONDS=300

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001
